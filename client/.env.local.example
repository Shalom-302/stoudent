# Where the Next server forwards /api/v1 and /admin/api/v1 (read at runtime,
# server-side only). The browser never calls the API directly.
API_INTERNAL_URL=http://localhost:8000

# Optional: bypass the proxy and have the browser call the API directly
# (baked in at build time). Leave unset in Docker / Dokploy.
# NEXT_PUBLIC_API_URL=http://localhost:8000
